# v2.0.0 production env template
# Copy to infra/.env before: docker compose -f infra/docker-compose.prod.yml up -d --build
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=kc-change-me-prod
DB_NAME=kc_prod
PORT=4000
NEXT_PUBLIC_API_URL=/api
# Required for secure JWT signing (use a long random value in real deployments)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# M6/M7 refresh cookie: false on HTTP :8080; TLS overlay forces COOKIE_SECURE=true
COOKIE_SECURE=false
# Public cookie path as seen by the browser (nginx /api prefix)
REFRESH_COOKIE_PATH=/api/auth
# Optional override when using docker-compose.tls.yml (defaults set in overlay)
# CORS_ORIGINS_TLS=https://127.0.0.1:8443,https://localhost:8443
# Swagger /api/docs — off in production unless explicitly enabled
ENABLE_SWAGGER=false
# Frontend lab UI (demo passwords + /dev) — must be "true" at image build time to enable
NEXT_PUBLIC_ENABLE_LAB_UI=false
#
# v1.1.0 CTF overlay (docker-compose.ctf.yml) — never on secure main path
# CTF_MODE=true
# JWT_SECRET=kc-ctf-lab-jwt-secret
# DB_PASSWORD=KcCtfDbPr0of2026!
# ENABLE_SWAGGER=true
# Optional Nest global throttle ceiling (auth routes have tighter @Throttle)
THROTTLE_GLOBAL_LIMIT=300
#
# Docker secrets pattern (real deployments): prefer file mounts over env plaintext
#   POSTGRES_PASSWORD_FILE=/run/secrets/db_password
#   JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem  (already used in compose)
