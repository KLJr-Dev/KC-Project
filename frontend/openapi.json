  "info": {
    "title": "KC-Project API",
    "description": "KC-Project HTTP API (secure product v2.1.0). Historical vuln-era summaries removed.",
    "version": "2.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "username"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "userId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "object"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "username",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UploadFileDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          }
        }
      },
      "FileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "mimetype": {
            "type": "string"
          },
          "storagePath": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "approvalStatus": {
            "type": "object"
          },
          "uploadedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "filename",
          "uploadedAt"
        ]
      },
      "ApproveFileDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object"
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateSharingDto": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "fileId"
        ]
      },
      "SharingResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "fileId": {
            "type": "string"
          },
          "publicToken": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdAt"
        ]
      },
      "UpdateSharingDto": {
        "type": "object",
        "properties": {
          "public": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string"
          }
        }
      },
      "UserListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "default": "",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "email": {
            "type": "string",
            "default": "",
            "example": "alice@example.com"
          },
          "username": {
            "type": "string",
            "default": "",
            "example": "alice"
          },
          "role": {
            "type": "string",
            "default": "user",
            "example": "admin",
            "enum": [
              "user",
              "moderator",
              "admin"
            ]
          },
          "createdAt": {
            "type": "object",
            "default": ""
          },
          "updatedAt": {
            "type": "object",
            "default": ""
          }
        },
        "required": [
          "id",
          "email",
          "username",
          "role",
          "createdAt",
          "updatedAt"
        ]
      },
      "GetAdminUsersResponseDto": {
        "type": "object",
        "properties": {
          "users": {
            "default": [],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserListItemDto"
            }
          },
          "count": {
            "type": "number",
            "default": 0,
            "example": 3
          }
        },
        "required": [
          "users",
          "count"
        ]
      },
      "UpdateUserRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "example": "admin",
            "enum": [
              "user",
              "moderator",
              "admin"
            ]
          }
        },
        "required": [
          "role"
        ]
      }
    }
  }
}
