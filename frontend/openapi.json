          "403": {
            "description": "Forbidden (not moderator or admin)"
          },
          "404": {
            "description": "User not found"
          }
        },
        "summary": "Escalate user role (admin only)",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/audit-logs": {
